# OmniSight Backend Configuration Template
# Copy this file to backend/.env and populate with your local values.
# NEVER commit backend/.env to git!

# GitHub Automation Credentials
GITHUB_TOKEN=your_github_personal_access_token_here
REPO_NAME=Kailash-18/OmniSight
MOCK_GITHUB=false

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=false

# SSRF Security: Allowed Hostnames for Browser Audit Triggers
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,0.0.0.0,staging.internal

# Patch Security: Allowed target files and directories
ALLOWED_PATCH_FILES=app-under-test/src/styles/defects.css,app-under-test/src/styles/base.css,app-under-test/src/components/,app-under-test/src/App.jsx

# Patch Limits
MAX_DIFF_LINES=300
MAX_DIFF_BYTES=30000
