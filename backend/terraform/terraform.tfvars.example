# ==============================================================================
# OmniSight Terraform Variables Template
#
# INSTRUCTIONS:
# 1. Copy this file to 'terraform.tfvars' in this directory.
# 2. Fill in the sensitive values (e.g. github_token).
# 3. NEVER commit 'terraform.tfvars' to source control. It is protected by .gitignore.
# ==============================================================================

aws_region           = "us-east-1"
environment          = "staging"
app_name             = "omnisight-backend"
container_image      = "123456789012.dkr.ecr.us-east-1.amazonaws.com/omnisight-backend:latest"
container_port       = 8000
cpu                  = "1024"
memory               = "2048"

# GitHub Configuration (Do NOT share or commit actual token)
github_token         = "ghp_EXAMPLE_TOKEN_REPLACE_WITH_YOUR_FINE_GRAINED_TOKEN"
repo_name            = "Kailash-18/OmniSight"
mock_github          = false

# Allowed Hosts for SSRF Guardrails
allowed_target_hosts = "localhost,127.0.0.1,staging.internal"
